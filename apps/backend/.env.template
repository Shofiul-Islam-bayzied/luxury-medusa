STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=
DATABASE_URL=
DB_NAME=medusa-backend

# Optional Postgres TLS mode: true (verified), false (off), no-verify (encrypted,
# unverified). Default: verified TLS for any host containing a dot except
# 127.0.0.1. Never put sslmode= in DATABASE_URL. DATABASE_CA_CERT takes a PEM
# for providers with a private CA (e.g. Supabase prod-ca-2021.crt).
# DATABASE_SSL=true
# DATABASE_CA_CERT=

# Production (Render). MEDUSA_BACKEND_URL is baked into the admin at build time.
# NODE_ENV=production
# MEDUSA_WORKER_MODE=shared
# MEDUSA_BACKEND_URL=https://your-app.onrender.com
# DISABLE_MEDUSA_ADMIN=false

# Optional PayStation payment provider (pp_paystation_paystation), registered
# only when PAYSTATION_MERCHANT_ID is set. Sandbox unless PAYSTATION_SANDBOX=false.
# Public sandbox credentials from paystation.com.bd/documentation:
# PAYSTATION_MERCHANT_ID=104-1653730183
# PAYSTATION_PASSWORD=gamecoderstorepass
# PAYSTATION_SANDBOX=true
# Where PayStation returns the shopper (the storefront's payment result page):
# PAYSTATION_CALLBACK_URL=https://your-store.com/checkout/paystation
# Origins a storefront may use for its own data.callback_url (comma-separated):
# PAYSTATION_CALLBACK_ORIGINS=https://your-store.com
# PAYSTATION_PAY_WITH_CHARGE=false

# Optional S3-compatible file storage (Cloudflare R2, Supabase Storage, AWS S3).
# Without S3_BUCKET, uploads go to local disk, which Render wipes on every deploy.
# S3_FILE_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
